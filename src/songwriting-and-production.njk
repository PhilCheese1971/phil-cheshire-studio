---js
{
  layout: "base.njk",
  headerClass: "secondary",
  eleventyComputed: {
    heading1AndLeadParagraph: (data) => data.songwritingHeadingAndLead,
    title: (data) => {
      const heading = data.heading1AndLeadParagraph?.fields?.heading1Text;
      if (!heading) return "PhilCheshire.studio";
      const text = heading
        .replace(/&/g, "and")
        .toLowerCase()
        .replace(/\b\w/g, (c) => c.toUpperCase());
      return `${text} > PhilCheshire.studio`;
    },
  },
}
---
<h1 class="has-jump-to-nav">{{ heading1AndLeadParagraph.fields.heading1Text }}</h1>
{% set jumpToLinks = [
    {
        url: "#songwriting", 
        label: "Songwriting"
    },
    {
        url: "#production", 
        label: "Production"
    },
    {
        url: "#latest", 
        label: "Latest releases"
    }
] %}
{% include "jump-to-menu.njk" %}
<p class="lead">
  {{ heading1AndLeadParagraph.fields.leadParagraph | safe }}
</p>
<div class="cms-richtext" id="songwriting">
  {{ songwritingAndProduction.fields.songwritingTextAndInlineMusic | toHtml | safe }}
</div>
<hr>
<div class="cms-richtext" id="production">
  {{ songwritingAndProduction.fields.productionTextAndInlineMusic | toHtml | safe }}
</div>
<div class="cms-richtext" id="latest">
  {{ songwritingAndProduction.fields.latestReleases | toHtml | safe }}
</div>