
<dialog class="{{ dialogClass }}" aria-live="polite" data-name="mobile-menu-dialog">
    <h2 class="visually-hidden">Mobile menu</h2>
    <button type="button" class="close-button" data-target="mobile-menu-dialog" data-dialogtrigger>
        <span class="visually-hidden">Close mobile menu</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" fill="none" viewBox="0 0 44 44">
            <path fill="currentcolor" d="M22 26.518 5.479 43.038Q4.518 44 3.22 44t-2.258-.962Q0 42.078 0 40.78t.962-2.259L17.482 22 .962 5.479Q0 4.518 0 3.22T.962.962Q1.922 0 3.22 0T5.48.962L22 17.482 38.521.962Q39.483 0 40.78 0q1.298 0 2.258.962.962.96.962 2.258t-.962 2.259L26.518 22l16.52 16.521q.962.962.962 2.259 0 1.298-.962 2.258-.96.962-2.258.962t-2.259-.962z"/>
        </svg>
    </button>
    <nav class="menu menu--main menu--main--mobile" aria-label="Main site menu">
    {% include "main-menu.njk" %}
    </nav>
    <hr class="mobile-divider">
    <nav class="menu menu--global menu--mobile" aria-label="Tertiary site menu">
        <ul>
            {% for navItem in tertiaryNavItems %}
                {% set isCurrent = (page.url == navItem.url) %}
                <li>
                    {% if isCurrent %}
                        <span aria-current="page">{{ navItem.label }}</span>
                    {% else %}
                        <a href="{{ navItem.url }}">{{ navItem.label }}</a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </nav>
</dialog>