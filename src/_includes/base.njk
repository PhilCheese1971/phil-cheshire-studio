<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="author" content="Phil Cheshire">
        <meta name="description" content="Phil Cheshire's portfolio site">
        <title>{{ title }}</title>
        <!-- Fav icons -->
        <!-- <link rel="icon" href="./favicon.ico" /> -->
        <!-- Fonts -->
        <link rel="preconnect" href="https://googleapis.com">
        <link rel="preconnect" href="https://gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru:wght@400&family=Open+Sans&family=Roboto+Slab:wght@900&display=swap" rel="stylesheet">
        <!-- Stylesheet -->
        <link rel="stylesheet" href="/assets/css/styles.css" media="all">
        {% if gallery %}<link rel="stylesheet" href="/photoswipe/photoswipe.css">{% endif %}
    </head>
    {% set tertiaryNavItems = [
        {
            url: "/" ~ (aboutMe.fields.tertiaryPageHeading | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
            label: aboutMe.fields.tertiaryPageHeading
        },
        {
            url: "/" ~ (talkToMe.fields.tertiaryPageHeading | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
            label: talkToMe.fields.tertiaryPageHeading
        },
        {
            url: "/" ~ (otherInterests.fields.tertiaryPageHeading | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
            label: otherInterests.fields.tertiaryPageHeading
        }
    ] %}
    <body>
        <div class="site-container">
            <header class="header grid {{ headerClass }}">
                    <div class="col-3">
                        {% homeLogoLink "/" %}
                    </div>
                    {% if page.url == '/' %}
                        {{ headerContent | safe }}
                    {% else %}
                        <div class="show-for-large col-large-6">
                            <nav class="menu menu--main menu--main--desktop-tablet " aria-label="Main site menu">
                                {% include "main-menu.njk" %}
                            </nav>
                        </div>
                    {% endif %}
                    <div class="col-large-3 show-for-large">
                        <nav class="menu menu--global menu--global--desktop-tablet" aria-label="Tertiary site menu">
                            <ul>
                                {% for navItem in tertiaryNavItems %}
                                    {% set isCurrent = (page.url == navItem.url) %}
                                    <li>
                                        {% if isCurrent %}
                                            <span aria-current="page">{{ navItem.label }}</span>
                                        {% else %}
                                            <a href="{{ navItem.url }}">{{ navItem.label }}</a>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                    </nav>
                    </div>
                    <div class="col-9 hide-for-large mobile-menu-wrapper">
                        <button class="menu-button" type="button" data-target="mobile-menu-dialog" data-dialogtrigger> 
                            <svg xmlns="http://www.w3.org/2000/svg" width="52" height="41" fill="none" viewBox="0 0 52 41">
                                <path fill="currentcolor" d="M2.594 41a2.5 2.5 0 0 1-1.836-.764A2.53 2.53 0 0 1 0 38.384q0-1.086.758-1.856a2.48 2.48 0 0 1 1.836-.768h46.773q1.093 0 1.863.773t.77 1.87-.77 1.848-1.863.749zm0-11.943q-1.077 0-1.836-.762Q0 27.535 0 26.425t.758-1.859q.759-.75 1.836-.75h46.773q1.093 0 1.863.762t.77 1.87-.77 1.86-1.863.75zm0-11.834q-1.077 0-1.836-.761Q0 15.7 0 14.59q0-1.11.758-1.86.759-.748 1.836-.748h46.773q1.093 0 1.863.761t.77 1.871-.77 1.859-1.863.749zm0-11.982q-1.077 0-1.836-.765A2.53 2.53 0 0 1 0 2.624Q0 1.538.758.77A2.48 2.48 0 0 1 2.594 0h46.773q1.093 0 1.863.773t.77 1.87q0 1.1-.77 1.848-.77.75-1.863.75z"/>
                            </svg>
                                <span class="visually-hidden">Open mobile menu</span>
                        </button>
                    </div>
                
            </header>
            <main>
                <section>{{ content | safe }}</section>
            </main>
           
        </div>
         <footer>
                <p>&copy; Phil Cheshire <span id="currentYear"> {% currentYear %}.</span> All rights reserved.</p>
            </footer>
            <script>document.querySelector("#currentYear").textContent = new Date().getFullYear();</script>
            <!-- <script src="./page.js"></script> -->
            <script type="module" src="/assets/js/dialog-triggers.js">
            // import { trapFocusInDialog } from '${ctx.contextPath}/.resources/goodthings-magnolia/webresources/js/trap-dialog-focus.js';
            // window.trapFocusInDialog = trapFocusInDialog;
        </script>
        {% set dialogClass = "dialog--mobile-menu" %}
        {% include 'dialog.njk' %}
        {% if youTube %}
            <script src="/assets/js/youtube-hide-film-tags.js"></script>
        {% endif %}
        {% if gallery %}
            <script type="module" src="{{ '/assets/js/vendor/gallery.js' | url }}"></script>
        {% endif %}
    </body>
</html>