<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="author" content="Phil Cheshire">
        <meta name="description" content="Phil Cheshire's portfolio site">
        <title>{{ title }}</title>
        <!-- Fav icons -->
        <link rel="icon" type="image/png" href="/assets/images/icons/favicon/favicon-96x96.png" sizes="96x96">
        <link rel="icon" type="image/svg+xml" href="/assets/images/icons/favicon.svg">
        <link rel="shortcut icon" href="/assets/images/icons/favicon.ico">
        <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/icons/apple-touch-icon.png">
        <meta name="apple-mobile-web-app-title" content="Phil Cheese">
        <link rel="manifest" href="/assets/images/icons/site.webmanifest">
        <!-- Fonts -->
        <link rel="preconnect" href="https://googleapis.com">
        <link rel="preconnect" href="https://gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru:wght@400&family=Open+Sans&family=Roboto+Slab:wght@900&display=swap" rel="stylesheet">
        <!-- Stylesheet -->
        <link rel="stylesheet" href="/assets/css/styles.css" media="all">
        {% if gallery %}<link rel="stylesheet" href="/photoswipe/photoswipe.css">{% endif %}
    </head>
    {% set tertiaryNavItems = [
        {
            url: "/" ~ (aboutMe.fields.tertiaryPageHeading | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
            label: aboutMe.fields.tertiaryPageHeading
        },
        {
            url: "/" ~ (talkToMe.fields.tertiaryPageHeading | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
            label: talkToMe.fields.tertiaryPageHeading
        },
        {
            url: "/" ~ (otherInterests.fields.tertiaryPageHeading | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
            label: otherInterests.fields.tertiaryPageHeading
        }
    ] %}
    <body>
        <div class="site-container {{ siteContainerClass }}">
            <header class="header grid {{ headerClass }}">
                <div class="col-3">
                    {% if page.url == '/' %}
                        <h1 aria-label="Welcome to Phil Cheshire's portfolio site">
                            {% homeLogoLink "/" %}
                        </h1>
                    {% else %}
                        {% homeLogoLink "/" %}
                    {% endif %}
                </div>
                {% if page.url == '/' %}
                    {{ headerContent | safe }}
                {% else %}
                    <div class="col-medium-6 show-for-medium">
                        {% include "main-menu.njk" %}
                    </div>
                {% endif %}
                <div class="col-medium-3 show-for-medium">
                    <nav class="menu menu--global menu--global--desktop-tablet" aria-label="Tertiary site menu">
                        <ul>
                            {% for navItem in tertiaryNavItems %}
                                {% set isCurrent = (page.url == navItem.url) %}
                                <li>
                                    {% if isCurrent %}
                                        <span aria-current="page">{{ navItem.label }}</span>
                                    {% else %}
                                        <a href="{{ navItem.url }}">{{ navItem.label }}</a>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </nav>
                </div>
                {% if page.url != '/' %}
                    {% set secondary = true %}
                {% else %}
                    {% set secondary = false %}
                {% endif %}
                {% include "mobile-menu-column.njk" %}
            </header>
            <main>
                <section>{{ content | safe }}</section>
            </main>
        </div>
        <footer>
            <p>&copy; Phil Cheshire <span id="currentYear"> {% currentYear %}.</span> All rights reserved.</p>
        </footer>
        <script>document.querySelector("#currentYear").textContent = new Date().getFullYear();</script>
        <!-- <script src="./page.js"></script> -->
        <script type="module" src="/assets/js/dialog-triggers.js"></script>
        {% set dialogClass = "dialog--mobile-menu" %}
        {% include 'dialog.njk' %}
        {% if youTube %}
            <script src="/assets/js/vendor/lt-youtube-embed.js" defer></script>
            <script src="/assets/js/youtube-hide-film-tags.js"></script>
        {% endif %}
        {% if gallery %}
            <script type="module" src="/assets/js/vendor/gallery.js"></script>
        {% endif %}
    </body>
</html>