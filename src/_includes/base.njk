<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="author" content="Phil Cheshire">
        <meta name="description" content="Phil Cheshire's portfolio site" />
        <title>{{ title }}</title>
        <!-- Fav icons -->
        <!-- <link rel="icon" href="./favicon.ico" /> -->
        <!-- Fonts -->
        <link rel="preconnect" href="https://googleapis.com">
        <link rel="preconnect" href="https://gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru:wght@400&family=Open+Sans&family=Roboto+Slab:wght@900&display=swap" rel="stylesheet">
        <!-- Stylesheet -->
        <link rel="stylesheet" href="/assets/css/styles.css" media="all" />
    </head>
    {% set globalNavItems = [
        { url: "/about-me/", label: "About me" },
        { url: "/talk-to-me/", label: "Talk to me" },
        { url: "/other-interests/", label: "I also..." }
    ] %}
    <body>
        <div class="site-container">
            <header class="header">
                <div class="column1">
                    {% homeLogoLink "/" %}
                </div>
                <div class="column2">
                    {% if page.url == '/' %}
                        {{ headerContent | safe }}
                    {% else %}
                        {% include "main-menu.njk" %}
                    {% endif %}
                </div>
                <div class="column3"> 
                    <nav class="menu menu--global">
                        <ul>
                            {% for item in globalNavItems %}
                                {% set isCurrent = (page.url == item.url) %}
                                <li>
                                    {% if isCurrent %}
                                        <span>{{ item.label }}</span>
                                    {% else %}
                                        <a href="{{ item.url }}">{{ item.label }}</a>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </nav>
                </div>
            </header>
            <main>
                <section>{{ content | safe }}</section>
            </main>
            <footer>
                <p>&copy; Phil Cheshire 2026. All rights reserved.</p>
            </footer>
            <!-- <script src="./page.js"></script> -->
        </div>
    </body>
</html>