<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="author" content="Phil Cheshire">
        <meta name="description" content="Phil Cheshire's portfolio site">
        <title>{{ title }}</title>
        <!-- Fav icons -->
        <!-- <link rel="icon" href="./favicon.ico" /> -->
        <!-- Fonts -->
        <link rel="preconnect" href="https://googleapis.com">
        <link rel="preconnect" href="https://gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru:wght@400&family=Open+Sans&family=Roboto+Slab:wght@900&display=swap" rel="stylesheet">
        <!-- Stylesheet -->
        <link rel="stylesheet" href="/assets/css/styles.css" media="all">
        {% if gallery %}<link rel="stylesheet" href="/photoswipe/photoswipe.css">{% endif %}
    </head>
    {% set tertiaryNavItems = [
        {
            url: "/" ~ (aboutMe.fields.tertiaryPageHeading | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
            label: aboutMe.fields.tertiaryPageHeading
        },
        {
            url: "/" ~ (talkToMe.fields.tertiaryPageHeading | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
            label: talkToMe.fields.tertiaryPageHeading
        },
        {
            url: "/" ~ (otherInterests.fields.tertiaryPageHeading | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
            label: otherInterests.fields.tertiaryPageHeading
        }
    ] %}
    <body>
        <div class="site-container">
            <header class="header grid {{ headerClass }}">
                <div class="col-3">
                    {% homeLogoLink "/" %}
                </div>
                <div class="col-6">
                    {% if page.url == '/' %}
                        {{ headerContent | safe }}
                    {% else %}
                        {% include "main-menu.njk" %}
                    {% endif %}
                </div>
                <div class="col-3"> 
                    <nav class="menu menu--global">
                        <ul>
                            {% for navItem in tertiaryNavItems %}
                                {% set isCurrent = (page.url == navItem.url) %}
                                <li>
                                    {% if isCurrent %}
                                        <span aria-current="page">{{ navItem.label }}</span>
                                    {% else %}
                                        <a href="{{ navItem.url | url }}">{{ navItem.label }}</a>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </nav>
                </div>
            </header>
            <main>
                <section>{{ content | safe }}</section>
            </main>
            <footer>
                <p>&copy; Phil Cheshire 2026. All rights reserved.</p>
            </footer>
            <!-- <script src="./page.js"></script> -->
        </div>
        {% if gallery %}
            <script type="module" src="/assets/js/vendor/gallery.js"></script>
        {% endif %}
    </body>
</html>