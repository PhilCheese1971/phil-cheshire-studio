{% set mainNavLinks = [
    { url: "/websites-and-web-apps/", label: "Websites & web apps" },
    { url: "/video-and-film-editing/", label: "Video & film editing" },
    { url: "/songwriting-and-production/", label: "Songwriting & production" }
] %}
<nav class="menu menu--main">
    <ul>
        {% for navLink in mainNavLinks %}
            {% set isCurrent = (page and page.url == navLink.url) %}
            <li>
                {% if isCurrent %}
                    <span>{{ navLink.label }}</span>
                {% else %}
                    <a href="{{ navLink.url }}">{{ navLink.label }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</nav>