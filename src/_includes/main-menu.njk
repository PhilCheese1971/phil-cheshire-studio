{% set mainNavLinks = [
    {
        url: "/" ~ (websitesHeadingAndBlurb.fields.heading1Text | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
        label: websitesHeadingAndBlurb.fields.heading1Text
    },
    {
        url: "/" ~ (videoAndFilmHeadingAndBlurb.fields.heading1Text | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
        label: videoAndFilmHeadingAndBlurb.fields.heading1Text
    },
    {
        url: "/" ~ (songwritingHeading.fields.heading1Text | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
        label: songwritingHeading.fields.heading1Text
    }
] %}
<nav class="menu menu--main">
    <ul>
        {% for navLink in mainNavLinks %}
            {% set isCurrent = (page and page.url == navLink.url) %}
            <li>
                {% if isCurrent %}
                    <span aria-current="page">{{ navLink.label }}</span>
                {% else %}
                    <a href="{{ navLink.url }}">{{ navLink.label }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</nav>