{% set mainNavLinks = [
    {
        url: "/" ~ (recentWebWorkHeadingAndLead.fields.heading1Text | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
        label: recentWebWorkHeadingAndLead.fields.heading1Text
    },
    {
        url: "/" ~ (videoAndFilmHeadingAndLead.fields.heading1Text | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
        label: videoAndFilmHeadingAndLead.fields.heading1Text
    },
    {
        url: "/" ~ (songwritingHeadingAndLead.fields.heading1Text | replace('&', 'and') | replace(' ', '-') | lower) ~ "/", 
        label: songwritingHeadingAndLead.fields.heading1Text
    }
] %}

    <ul>
        {% for navLink in mainNavLinks %}
            {% set isCurrent = (page and page.url == navLink.url) %}
            <li>
                {% if isCurrent %}
                    <span aria-current="page">{{ navLink.label }}</span>
                {% else %}
                    <a href="{{ navLink.url }}">{{ navLink.label }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
