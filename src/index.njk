---
layout: base.njk
title:
    PhilCheshire.studio
eleventyComputed:
    headerContent:
        <div class="col-small-7 show-for-small hide-for-medium">
            {% include "header-home-images.njk" %}
        </div>
        <div class="col-medium-6 show-for-medium">
            {% include "header-home-images.njk" %}
        </div>
siteContainerClass: 'home'
---
<div class="heading-one-and-strapline heading-one-and-strapline--mobile hide-for-large">
    <h1>WELCOME</h1>
    <p>Let's make the digital world a better place.</p>
</div>

<nav class="menu menu--home">
    <ul class="grid">
        {% for image in homepageBannerImages %}
            <li class="col-12">
                <a class="home-banner" href="/{{ image.fields.title  | replace(' ', '-') | replace('&', 'and') | lower }}/" style="background-image: url('https:{{ image.fields.file.url }}?fm=webp&q=80');"><span>{{ image.fields.title }} &gt;</span></a>
            </li>
        {% endfor %}
    </ul>
</nav>