---js
{
  layout: "base.njk",
  headerClass: "secondary",
  eleventyComputed: {
    heading1AndLeadParagraph: (data) => data.videoAndFilmHeadingAndLead,
    title: (data) => {
      const heading = data.heading1AndLeadParagraph?.fields?.heading1Text;
      if (!heading) return "Phil Cheese Studio";
      const text = heading
        .replace(/&/g, "and")
        .toLowerCase()
        .replace(/\b\w/g, (c) => c.toUpperCase());
      return `${text} > Phil Cheese Studio`;
    },
  },
}
---
<h1>{{ heading1AndLeadParagraph.fields.heading1Text }}</h1>
<p class="lead">
  {{ heading1AndLeadParagraph.fields.leadParagraph | safe }}
</p>
<ul class="grid cards cards--video">
  {% for card in videoAndFilmCards %}
        <li class="col-12 col-medium-6 display-flex card">
          <div class="card__video">
            <span class="film-tag">{{ card.fields.filmAndVideoTag }}</span>
            {% set videoTitle = card.fields.filmAndVideoHeading %}
            {% set videoId = card.fields.youTubeReference %}
            {% include 'youtube.njk' %}
          </div>
          <div class="card__content">
            <div class="card__content__description">
              <h2>{{ card.fields.filmAndVideoHeading }}</h2>
              <p>{{ card.fields.filmAndVideoDescription }}</p>
            </div>
            <div class="card__footer">
              <hr class="video-content-divider">
              <span>Editing: </span>
              <ul class="skills-list display-inline">
                {% for skill in card.fields.filmAndVideoEditingList %}
                  <li class="display-inline">{{ skill | trim }}</li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </li>
  {% else %}
    <li>No video cards found.</li>
  {% endfor %}
</ul>