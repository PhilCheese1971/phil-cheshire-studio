---
layout: base.njk
youTube: true
eleventyComputed:
  title: "{{ videoAndFilmHeadingAndBlurb.fields.heading1Text | replace('&', 'and') | title }} > PhilCheshire.studio"
headerClass: 'secondary'
---
<h1>{{ videoAndFilmHeadingAndBlurb.fields.heading1Text }}</h1>
{{ videoAndFilmHeadingAndBlurb.fields.topParagraph | toHtml | safe }}
<ul class="grid video-banners">
  {% for panel in videoAndFilmPanels %}
        <li class="col-12 col-medium-6 display-flex">
          <div class="video-banners__video">
             <span class="film-tag">{{ panel.fields.filmAndVideoTag }}</span>
            {% set videoTitle = panel.fields.filmAndVideoHeading %}
            {% set videoId = panel.fields.youTubeReference %}
            {% include 'youtube.njk' %}
          </div>
          <div class="video-banners__info">
            <div class="video-banners__info__content">
              <h2>{{ panel.fields.filmAndVideoHeading }}</h2>
              <p>{{ panel.fields.filmAndVideoDescription }}</p>
            </div>
            <div class="video-banners__info__footer">
              <hr>
              <span>Editing: </span>
              <ul class="skills-list display-inline">
                {% for skill in panel.fields.filmAndVideoEditingList %}
                  <li class="display-inline">{{ skill | trim }}</li>
                {% endfor %}
              </ul>
            </div>
            
          </div>
        </li>
  {% else %}
    <li>No video panels found.</li>
  {% endfor %}
</ul>