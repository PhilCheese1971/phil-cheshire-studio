---js
{
  layout: "base.njk",
  headerClass: "secondary",
  eleventyComputed: {
    heading1AndLeadParagraph: (data) => data.websitesHeadingAndLead,
    title: (data) => {
      const heading = data.heading1AndLeadParagraph?.fields?.heading1Text;
      if (!heading) return "PhilCheshire.studio";
      const text = heading
        .replace(/&/g, "and")
        .toLowerCase()
        .replace(/\b\w/g, (c) => c.toUpperCase());
      return `${text} > PhilCheshire.studio`;
    },
  },
}
---
<h1>{{ heading1AndLeadParagraph.fields.heading1Text }}</h1>
<div class="cms-richtext">
  <p class="lead">
    {{ heading1AndLeadParagraph.fields.leadParagraph | safe }}
  </p>
</div>
<ul class="cards cards--web">
  {% for card in caseStudyCards %}
      <li class="grid card">
        <div aria-hidden="true" class="card__image col-12 col-medium-6"{% if card.fields.projectPhoto %} style="background-image: url('https:{{ card.fields.projectPhoto.fields.file.url }}?fm=webp&w=396&q=80');"{% endif %}>
        </div>        
        <div class="card__content col-12 col-medium-6">
            <div class="cms-richtext">
              {{ card.fields.projectInfoTable | toHtml | safe }}
              {% set link =  card.fields.projectLink %}
              {% set linkText = " the " + card.fields.projectTitle + " site" %}
              {% include 'link-in-new-window.njk' %}
            </div>
        </div>
      </li>
  {% else %}
    <li>No cards found.</li>
  {% endfor %}
</ul>