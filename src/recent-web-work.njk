---js
{
  layout: "base.njk",
  headerClass: "secondary",
  eleventyComputed: {
    heading1AndLeadParagraph: (data) => data.recentWebWorkHeadingAndLead,
    title: (data) => {
      const heading = data.heading1AndLeadParagraph?.fields?.heading1Text;
      if (!heading) return "PhilCheshire.studio";
      const text = heading
        .replace(/&/g, "and")
        .toLowerCase()
        .replace(/\b\w/g, (c) => c.toUpperCase());
      return `${text} > PhilCheshire.studio`;
    },
  },
}
---
<h1>{{ heading1AndLeadParagraph.fields.heading1Text }}</h1>
<div class="cms-richtext">
  <p class="lead">
    {{ heading1AndLeadParagraph.fields.leadParagraph | safe }}
  </p>
</div>
<ul class="web-banners">
  {% for banner in caseStudyBanners %}
      <li class="grid">
        <div class="banner-background col-12 col-medium-6"{% if banner.fields.projectPhoto %} style="background-image: url('https:{{ banner.fields.projectPhoto.fields.file.url }}?fm=webp&w=396&q=80');"{% endif %}></div>        
        <div class="table-and-link col-12 col-medium-6">
            <div class="cms-richtext">
              {{ banner.fields.projectInfoTable | toHtml | safe }}
              <a href="/case-studies/{{ banner.fields.projectTitle | replace(' ', '-') | lower }}">Read more about {{ banner.fields.projectTitle }} ></a>
            </div>
        </div>
      </li>
  {% else %}
    <li>No banners found.</li>
  {% endfor %}
</ul>