---
layout: base.njk
eleventyComputed:
  title: "{{ talkToMe.fields.tertiaryPageHeading | replace('&', 'and') | title }} > PhilCheshire.studio"
headerClass: 'secondary'
---
<h1>{{ talkToMe.fields.tertiaryPageHeading }}</h1>
<p class="lead">{{ talkToMe.fields.tertiaryPageIntro }}</p>
<form action="https://api.web3forms.com/submit" method="POST" id="talkToMeForm" novalidate class="form">
    <input type="hidden" name="access_key" value="43bc6348-5660-4a5e-8eb9-dfcdb6c88c9a">
    <div class="form__item-wrapper">
      <label for="name">Full name</label>
      <input type="text" name="name" id="name" required autocomplete="name">
      <div class="error hide">Please provide your full name.</div>
    </div>
    <div class="form__item-wrapper">
      <label for="email" >Email address</label>
      <input type="email" name="email" id="email" required autocomplete="email">
      <div class="error hide">Please provide a valid email address.</div>
    </div>
    <div class="form__item-wrapper form__item-wrapper--large">
      <label for="message">What do you want to talk about?</label>
      <textarea name="message" id="message" required autocomplete="off"></textarea>
      <div class="error hide">Please let me know what you want to talk about.</div>
    </div>
    <div class="form__item-wrapper form__item-wrapper--medium">
      <span class="form-label display-block">Are you human?</span>
      <div class="h-captcha" data-captcha="true"></div>
      <div class="error error--hcaptcha hide">Please validate your humanity.</div>
    </div>
    <div class="display-flex flex-align-right">
      <button type="submit" id="submitButton">Send your message &gt;</button>
    </div>
</form>
<script src="https://web3forms.com/client/script.js" async defer></script>
<script defer src="/assets/js/formValidation.js"></script>