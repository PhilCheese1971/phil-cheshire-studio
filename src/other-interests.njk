---
layout: base.njk
gallery: true
eleventyComputed:
  title: "{{ otherInterests.fields.tertiaryPageHeading | replace('&', 'and') | title }} > Phil Cheese Studio"
headerClass: 'secondary'
---
<h1 class="has-jump-to-nav">{{ otherInterests.fields.tertiaryPageHeading }}</h1>
{% set jumpToLinks = [
    {
        url: "#writing", 
        label: "Writing"
    },
    {
        url: "#phonePhotography", 
        label: "Phone photography"
    }
] %}
{% include "jump-to-menu.njk" %}
<p class="lead">{{ otherInterests.fields.tertiaryPageIntro }}</p>
<div class="cms-richtext" id="writing">
{{ otherInterests.fields.tertiaryPageContent | toHtml | safe }}
</div>
<div class="cms-richtext" id="phonePhotography">
  {{ otherInterests.fields.secondOtherInterest | toHtml | safe }}
</div>
<div class="pswp-gallery" id="gallery" data-base="{{ '/' | url }}">
  {% for image in otherInterests.fields.otherInterestsGallery %}
    {% set full = image | ctfFull(2000) %}
    {% set d = image.fields.file.details.image %}
    {% set ratio = d.width / d.height %}
   <a href="{{ full.src }}"
   data-pswp-width="{{ full.width }}"
   data-pswp-height="{{ full.height }}"
   style="--r: {{ ratio | round(3) }};"
   target="_blank">
      <img src="https:{{ image.fields.file.url }}?w=600&fm=webp&q=75&f=center"
           alt="{{ image.fields.description or image.fields.title }}"
           width="{{ d.width }}" height="{{ d.height }}" loading="lazy">
    </a>
  {% endfor %}
</div>
