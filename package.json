{
  "name": "eleventy-cd-githubpages",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sass:dev": "sass --watch --embed-source-map src/assets/scss:dist/assets/css",
    "sass:build": "sass --style=compressed --no-source-map src/assets/scss:dist/assets/css",
    "eleventy:dev": "eleventy --serve",
    "eleventy:build": "eleventy --pathprefix=phil-cheshire-studio/",
    "start": "run-p eleventy:dev sass:dev",
    "build-ghpages": "run-s sass:build eleventy:build"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@contentful/rich-text-html-renderer": "^17.2.3",
    "@contentful/rich-text-types": "^17.2.7",
    "del": "^9.0.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "contentful@11.12.10": true,
    "dotenv@18.0.9": true,
    "@contentful/rich-text-html-renderer@17.2.3": true,
    "@contentful/rich-text-types@17.2.7": true,
    "es5-ext@0.10.64": true
  },
  "devDependencies": {
    "contentful": "^11.12.10",
    "dotenv": "^18.0.9",
    "npm-run-all": "^4.1.5",
    "sass": "^1.106.1"
  }
}
